# /etc/artgame-app/<prod|test>.env — права 640, владелец root:artgame-app. Значения в репозиторий не попадают.
# prod: PORT=8100, ARTGAME_ENV_NAME=prod, база artgame_prod
# test: PORT=8101, ARTGAME_ENV_NAME=test, база artgame_test
PORT=8100
ARTGAME_ENV_NAME=prod
ARTGAME_DATABASE_URL=postgresql:///artgame_prod?host=/var/run/postgresql
ARTGAME_BOT_TOKEN=
ARTGAME_HEAD_TG_ID=
# ключ шифрования ИИН/реквизитов: сгенерировать на сервере `openssl rand -hex 32`, у test и prod разные
ARTGAME_PRIVATE_KEY=
ARTGAME_GOOGLE_SA_FILE=/etc/artgame-app/google-sa.json
# папка Диска для чеков без объекта (ID папки), сервисный аккаунт должен иметь к ней доступ
ARTGAME_DRIVE_INBOX=
# шлюз ARTGAME-MCP-readonly на localhost (bitrix_read). Пусто = чтение идёт вебхуком ниже (так на test с 05.11)
ARTGAME_GATEWAY_URL=
ARTGAME_GATEWAY_TOKEN=
# Входящий вебхук Битрикса (CRM, Задачи, Пользователи, Диск) — чтение и запись из приложения, решение HEAD 05.11.
ARTGAME_BITRIX_WEBHOOK=
ARTGAME_PUBLIC_ORIGIN=https://test.app.artgame.world
# Ключ рабочих мест (hex 32 байта), расшифровывает backend/places/*.enc. Хранится только на сервере.
ARTGAME_CONTENT_KEY=
# Google Таблица-витрина финансов (ID): сервисному аккаунту — «Редактор». Пусто — витрина не пишется.
# ARTGAME_FIN_SHEET_ID= — по умолчанию витрина «Финансы 2026» (config.py)
# Ночная копия базы (artgame-backup@<env>.timer, 03:00). Пусто — копия только на сервере в /var/backups/artgame-app/<env>/.
# ID папки на Google Диске, куда сервисный аккаунт может писать (доступ «Редактор»):
BACKUP_DRIVE_FOLDER=
