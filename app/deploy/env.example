# /etc/artgame-app/<prod|test>.env — права 600, владелец artgame-app. Значения в репозиторий не попадают.
PORT=8100
ARTGAME_ENV_NAME=prod
ARTGAME_DATABASE_URL=postgresql:///artgame_prod?host=/var/run/postgresql
ARTGAME_BOT_TOKEN=
ARTGAME_HEAD_TG_ID=
ARTGAME_PRIVATE_KEY=
ARTGAME_GOOGLE_SA_FILE=/etc/artgame-app/google-sa.json
