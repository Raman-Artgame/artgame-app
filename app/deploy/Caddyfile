# /etc/caddy/Caddyfile (часть для приложения). Шлюз mcp.artgame.world не трогаем.
app.artgame.world {
	encode zstd gzip
	handle /api/* {
		reverse_proxy 127.0.0.1:8100
	}
	handle /assets/* {
		root * /srv/artgame-app/prod/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv/artgame-app/prod/web
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

test.app.artgame.world {
	encode zstd gzip
	handle /api/* {
		reverse_proxy 127.0.0.1:8101
	}
	handle /assets/* {
		root * /srv/artgame-app/test/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv/artgame-app/test/web
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
